{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start VS Code LM API (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-lm-extension"],
      "outFiles": ["${workspaceFolder}/vscode-lm-extension/out/**/*.js"],
      "preLaunchTask": "compile-lm-extension"
    }
  ]
}
